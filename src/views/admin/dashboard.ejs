<div class="max-w-7xl mx-auto px-6 py-8">
    <div class="mb-8">
        <h2 class="text-3xl font-extrabold text-white">Dashboard Overview</h2>
        <p class="text-zinc-500 text-sm mt-1">Real-time statistics & visual metrics of Veloshop</p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <!-- Stat item 1 -->
        <div class="bg-zinc-950 border border-white/5 p-6 rounded-3xl backdrop-blur-xl">
            <p class="text-xs uppercase tracking-wider text-zinc-500 font-semibold">Total Revenue</p>
            <h3 class="text-3xl font-black text-lime-400 mt-2">₹<%= stats.totalRevenue.toFixed(2) %></h3>
            <p class="text-xs text-zinc-500 mt-1">From successful sales transactions</p>
        </div>
        <!-- Stat item 2 -->
        <div class="bg-zinc-950 border border-white/5 p-6 rounded-3xl backdrop-blur-xl">
            <p class="text-xs uppercase tracking-wider text-zinc-500 font-semibold">Total Sales Count</p>
            <h3 class="text-3xl font-black text-white mt-2"><%= stats.totalSales %></h3>
            <p class="text-xs text-zinc-500 mt-1">Paid orders placed</p>
        </div>
        <!-- Stat item 3 -->
        <div class="bg-zinc-950 border border-white/5 p-6 rounded-3xl backdrop-blur-xl">
            <p class="text-xs uppercase tracking-wider text-zinc-500 font-semibold">Total Orders</p>
            <h3 class="text-3xl font-black text-white mt-2"><%= stats.totalOrders %></h3>
            <p class="text-xs text-zinc-500 mt-1">All orders in system</p>
        </div>
        <!-- Stat item 4 -->
        <div class="bg-zinc-950 border border-white/5 p-6 rounded-3xl backdrop-blur-xl">
            <p class="text-xs uppercase tracking-wider text-zinc-500 font-semibold">Total Customers</p>
            <h3 class="text-3xl font-black text-white mt-2"><%= stats.totalCustomers %></h3>
            <p class="text-xs text-zinc-500 mt-1">Registered users</p>
        </div>
    </div>

    <!-- Status Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <div class="bg-zinc-950 border border-white/5 p-6 rounded-3xl flex items-center justify-between">
            <div>
                <p class="text-xs uppercase tracking-wider text-zinc-500 font-semibold">Pending Orders</p>
                <h4 class="text-2xl font-bold text-yellow-500 mt-1"><%= stats.pendingOrders %></h4>
            </div>
            <div class="w-10 h-10 rounded-full bg-yellow-500/10 flex items-center justify-center text-yellow-500">⏳</div>
        </div>
        <div class="bg-zinc-950 border border-white/5 p-6 rounded-3xl flex items-center justify-between">
            <div>
                <p class="text-xs uppercase tracking-wider text-zinc-500 font-semibold">Cancelled Orders</p>
                <h4 class="text-2xl font-bold text-red-500 mt-1"><%= stats.cancelledOrders %></h4>
            </div>
            <div class="w-10 h-10 rounded-full bg-red-500/10 flex items-center justify-center text-red-500">✖</div>
        </div>
        <div class="bg-zinc-950 border border-white/5 p-6 rounded-3xl flex items-center justify-between">
            <div>
                <p class="text-xs uppercase tracking-wider text-zinc-500 font-semibold">Returned Orders</p>
                <h4 class="text-2xl font-bold text-purple-500 mt-1"><%= stats.returnedOrders %></h4>
            </div>
            <div class="w-10 h-10 rounded-full bg-purple-500/10 flex items-center justify-center text-purple-500">↩</div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-zinc-950 border border-white/5 p-6 rounded-3xl mb-8 backdrop-blur-xl">
        <form method="GET" action="/admin/dashboard" class="flex flex-wrap items-end gap-6">
            <div class="flex-1 min-w-[200px]">
                <label class="text-xs text-zinc-400 block mb-2 font-semibold">Analytical Period</label>
                <select name="filter" id="reportFilter" onchange="checkCustomRange()" class="w-full bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none text-white">
                    <option value="weekly" <%= filter === 'weekly' ? 'selected' : '' %>>Weekly Trends</option>
                    <option value="monthly" <%= filter === 'monthly' ? 'selected' : '' %>>Monthly Trends</option>
                    <option value="yearly" <%= filter === 'yearly' ? 'selected' : '' %>>Yearly Trends</option>
                    <option value="custom" <%= filter === 'custom' ? 'selected' : '' %>>Custom Date Range</option>
                </select>
            </div>

            <div class="flex-1 min-w-[150px] <%= filter === 'custom' ? '' : 'hidden' %>" id="startDateGroup">
                <label class="text-xs text-zinc-400 block mb-2 font-semibold">Start Date</label>
                <input type="date" name="startDate" value="<%= startDate %>" class="w-full bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none text-white">
            </div>

            <div class="flex-1 min-w-[150px] <%= filter === 'custom' ? '' : 'hidden' %>" id="endDateGroup">
                <label class="text-xs text-zinc-400 block mb-2 font-semibold">End Date</label>
                <input type="date" name="endDate" value="<%= endDate %>" class="w-full bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none text-white">
            </div>

            <button type="submit" class="bg-lime-400 hover:bg-lime-300 text-black font-bold text-sm px-6 py-3 rounded-xl transition">
                Apply Analytics Filter
            </button>
        </form>
    </div>

    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
        <!-- Revenue Trend -->
        <div class="bg-zinc-950 border border-white/5 p-6 sm:p-8 rounded-3xl backdrop-blur-xl">
            <h3 class="text-xl font-bold text-white mb-6">Revenue Trend (INR)</h3>
            <div class="relative w-full h-80">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- Orders Trend -->
        <div class="bg-zinc-950 border border-white/5 p-6 sm:p-8 rounded-3xl backdrop-blur-xl">
            <h3 class="text-xl font-bold text-white mb-6">Order Volume Trend</h3>
            <div class="relative w-full h-80">
                <canvas id="ordersChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Best Selling Products Top 10 Ledger -->
    <div class="bg-zinc-950 border border-white/5 rounded-3xl p-6 sm:p-8 backdrop-blur-xl mb-10">
        <h3 class="text-xl font-bold text-white mb-6">Top 10 Best Selling Products</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-zinc-900 text-zinc-400">
                    <tr>
                        <th class="p-4">Rank</th>
                        <th class="p-4">Product</th>
                        <th class="p-4">SKU</th>
                        <th class="p-4 text-center">Quantity Sold</th>
                        <th class="p-4 text-right">Revenue Generated</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5 text-white">
                    <% if (bestSellers && bestSellers.length > 0) { %>
                        <% bestSellers.forEach((item, index) => { %>
                            <tr class="hover:bg-white/5 transition">
                                <td class="p-4 font-bold text-lime-400">#<%= index + 1 %></td>
                                <td class="p-4 flex items-center gap-3">
                                    <img src="<%= item.thumbnail %>" class="w-10 h-10 object-cover rounded-lg" alt="<%= item.productName %>">
                                    <span class="font-medium"><%= item.productName %></span>
                                </td>
                                <td class="p-4 text-zinc-400"><%= item.sku %></td>
                                <td class="p-4 text-center font-semibold"><%= item.totalQuantity %></td>
                                <td class="p-4 text-right text-lime-400 font-bold">₹<%= item.totalRevenue.toFixed(2) %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-8 text-zinc-500">No completed sales recorded yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Best Selling Categories Top 10 Ledger -->
    <div class="bg-zinc-950 border border-white/5 rounded-3xl p-6 sm:p-8 backdrop-blur-xl mb-10">
        <h3 class="text-xl font-bold text-white mb-6">Top 10 Best Selling Categories</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-zinc-900 text-zinc-400">
                    <tr>
                        <th class="p-4">Rank</th>
                        <th class="p-4">Category Name</th>
                        <th class="p-4 text-center">Units Sold</th>
                        <th class="p-4 text-right">Revenue Generated</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5 text-white">
                    <% if (bestCategories && bestCategories.length > 0) { %>
                        <% bestCategories.forEach((item, index) => { %>
                            <tr class="hover:bg-white/5 transition">
                                <td class="p-4 font-bold text-lime-400">#<%= index + 1 %></td>
                                <td class="p-4 font-medium"><%= item.categoryName %></td>
                                <td class="p-4 text-center font-semibold"><%= item.totalQuantity %></td>
                                <td class="p-4 text-right text-lime-400 font-bold">₹<%= item.totalRevenue.toFixed(2) %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center py-8 text-zinc-500">No category sales recorded yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    function checkCustomRange() {
        const filter = document.getElementById("reportFilter").value;
        const start = document.getElementById("startDateGroup");
        const end = document.getElementById("endDateGroup");

        if (filter === "custom") {
            start.classList.remove("hidden");
            end.classList.remove("hidden");
        } else {
            start.classList.add("hidden");
            end.classList.add("hidden");
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        const labels = <%- chartLabels %>;
        const salesData = <%- salesTrends %>;
        const orderData = <%- orderTrends %>;

        // Revenue Line Chart
        const revCtx = document.getElementById('revenueChart').getContext('2d');
        new Chart(revCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Revenue (₹)',
                    data: salesData,
                    borderColor: '#a3e635',
                    backgroundColor: 'rgba(163, 230, 53, 0.1)',
                    borderWidth: 3,
                    tension: 0.3,
                    fill: true,
                    pointBackgroundColor: '#a3e635',
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#71717a' } },
                    y: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#71717a', callback: function(value) { return '₹' + value; } } }
                }
            }
        });

        // Orders Bar Chart
        const orderCtx = document.getElementById('ordersChart').getContext('2d');
        new Chart(orderCtx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Orders Volume',
                    data: orderData,
                    backgroundColor: '#818cf8',
                    borderColor: '#4f46e5',
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#71717a' } },
                    y: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#71717a', stepSize: 1 } }
                }
            }
        });
    });
</script>
