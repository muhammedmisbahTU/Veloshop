<div class="max-w-7xl mx-auto px-6 py-10">


<h1 class="text-3xl font-bold text-white mb-8">
Order Management
</h1>



<div class="bg-zinc-900 rounded-2xl overflow-hidden">


<table class="w-full text-left">


<thead class="bg-zinc-800 text-zinc-400">


<tr>

<th class="p-5">
Order ID
</th>


<th class="p-5">
Customer
</th>


<th class="p-5">
Date
</th>


<th class="p-5">
Payment
</th>


<th class="p-5">
Amount
</th>


<th class="p-5">
Status
</th>


<th class="p-5">
Action
</th>


</tr>


</thead>



<tbody>


<% orders.forEach(order=>{ %>


<tr class="border-t border-white/10 text-white">


<td class="p-5 whitespace-nowrap">


<span class="text-lime-400 font-semibold">

<%= order.orderNumber %>

</span>


</td>




<td class="p-5">


<p>
<%= order.userId.fullName %>
</p>


<p class="text-zinc-400 text-sm">

<%= order.userId.email %>

</p>


</td>




<td class="p-5 text-zinc-300 whitespace-nowrap">


<%= order.createdAt.toDateString() %>


</td>




<td class="p-5 whitespace-nowrap">


<%= order.paymentMethod %>


<br>


<span class="text-sm text-zinc-400">

<%= order.paymentStatus %>

</span>


</td>




<td class="p-5 text-lime-400 font-semibold whitespace-nowrap">


INR <%= order.grandTotal %>


</td>




<td class="p-5 whitespace-nowrap">


<span
class="
px-3 py-1 rounded-full text-sm font-semibold

<%= 
order.status==="DELIVERED"
?
"bg-green-500/20 text-green-400 border border-green-500/30"
:
order.status==="CANCELLED" || order.status==="PAYMENT_FAILED"
?
"bg-red-500/20 text-red-400 border border-red-500/30"
:
order.status==="RETURNED"
?
"bg-purple-500/20 text-purple-400 border border-purple-500/30"
:
"bg-yellow-500/20 text-yellow-400 border border-yellow-500/30"

%>
">


<%= order.status %>


</span>


</td>




<td class="p-5">


<a

href="/admin/orders/<%=order._id%>"

class="text-lime-400 hover:text-lime-300 whitespace-nowrap">

View

</a>


</td>



</tr>


<% }) %>


</tbody>


</table>



</div>


</div>