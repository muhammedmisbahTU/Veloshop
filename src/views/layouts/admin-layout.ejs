<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= locals.title || "Veloshop Admin" %></title>
        <link rel="icon" type="image/x-icon" href="/images/favicon.ico" >
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="https://unpkg.com/just-validate@latest/dist/just-validate.production.min.js"></script>
    <style>
        /* Custom date picker styling for dark mode */
        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(82%) sepia(28%) saturate(1212%) hue-rotate(42deg) brightness(98%) contrast(93%);
            cursor: pointer;
            padding: 5px;
            border-radius: 4px;
            transition: background-color 0.2s;
        }
        input[type="date"]::-webkit-calendar-picker-indicator:hover {
            background-color: rgba(163, 230, 53, 0.1);
        }
    </style>
</head>
<body class="min-h-screen bg-black text-white">
    <div class="flex min-h-screen">
        <aside class="hidden w-64 border-r border-white/10 bg-zinc-950 px-5 py-6 lg:block">
            <a href="/admin/users" class="block text-2xl font-black text-lime-400">VELOSHOP</a>
            <p class="mt-1 text-xs uppercase tracking-[0.24em] text-zinc-500">Admin</p>

            <nav class="mt-10 space-y-2 text-sm font-semibold text-zinc-300">
                <% const activeClass = "block border border-lime-400/30 bg-lime-400/10 px-4 py-3 text-lime-400"; %>
                <% const inactiveClass = "block border border-white/10 px-4 py-3 hover:border-lime-400/50 hover:text-lime-400"; %>
                <a href="/admin/dashboard" class="<%= (locals.path && path.startsWith('/admin/dashboard')) ? activeClass : inactiveClass %>">Dashboard</a>
                <a href="/admin/users" class="<%= (locals.path && path.startsWith('/admin/users')) ? activeClass : inactiveClass %>">Users</a>
                <a href="/admin/orders" class="<%= (locals.path && path.startsWith('/admin/orders')) ? activeClass : inactiveClass %>"> Orders </a>
                <a href="/admin/reports" class="<%= (locals.path && path.startsWith('/admin/reports')) ? activeClass : inactiveClass %>">Sales Reports</a>
                <a href="/admin/ledger" class="<%= (locals.path && path.startsWith('/admin/ledger')) ? activeClass : inactiveClass %>">Ledger Book</a>
                <a href="/admin/categories" class="<%= (locals.path && path.startsWith('/admin/categories')) ? activeClass : inactiveClass %>">Categories</a>
                <a href="/admin/products" class="<%= (locals.path && path.startsWith('/admin/products')) ? activeClass : inactiveClass %>">Products</a>
                <a href="/admin/offers" class="<%= (locals.path && path.startsWith('/admin/offers')) ? activeClass : inactiveClass %>">Offers</a>
                <a href="/admin/coupons" class="<%= (locals.path && path.startsWith('/admin/coupons')) ? activeClass : inactiveClass %>">Coupons</a>
                <a href="/" class="block border border-white/10 px-4 py-3 hover:border-lime-400/50 hover:text-lime-400">Storefront</a>
                <a href="/logout" class="block border border-white/10 px-4 py-3 hover:border-red-400/50 hover:text-red-400">Logout</a>
            </nav>
        </aside>

        <div class="min-w-0 flex-1">
            <header class="flex items-center justify-between border-b border-white/10 bg-zinc-950/80 px-5 py-4">
                <div>
                    <p class="text-xs uppercase tracking-[0.22em] text-lime-400">Control Panel</p>
                    <h1 class="text-xl font-black text-white"><%= locals.title || "Admin" %></h1>
                </div>
                <div class="text-right text-sm">
                    <p class="font-semibold text-white"><%= locals.user ? locals.user.fullName : "Admin" %></p>
                    <p class="text-xs text-zinc-500"><%= locals.user ? locals.user.email : "" %></p>
                </div>
            </header>

            <main class="px-5 py-6">
                <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                    <div class="mb-5 border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-300"><%= errorMessage %></div>
                <% } %>
                <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                    <div class="mb-5 border border-lime-500/30 bg-lime-500/10 p-4 text-sm text-lime-300"><%= successMessage %></div>
                <% } %>
                <%- body %>
            </main>
        </div>
    </div>
    <script>
      (function() {
        window.getCsrfToken = function() {
          return document.cookie
              .split("; ")
              .find(row => row.startsWith("XSRF-TOKEN="))
              ?.split("=")[1] || '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
        };

        const originalFetch = window.fetch;
        window.fetch = function(url, options) {
          options = options || {};
          const method = (options.method || 'GET').toUpperCase();
          if (['POST', 'PUT', 'DELETE', 'PATCH'].includes(method)) {
            options.headers = options.headers || {};
            const token = window.getCsrfToken();
            if (token) {
              if (options.headers instanceof Headers) {
                options.headers.set('X-CSRF-Token', token);
              } else {
                options.headers['X-CSRF-Token'] = token;
              }
            }
          }
          return originalFetch(url, options);
        };

        document.addEventListener('DOMContentLoaded', () => {
          const csrfToken = window.getCsrfToken();
          if (csrfToken) {
            document.querySelectorAll('form[method="POST"], form[method="post"]').forEach(form => {
              if (!form.querySelector('input[name="csrfToken"]')) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'csrfToken';
                input.value = csrfToken;
                form.appendChild(input);
              }
            });
          }
        });
      })();
    </script>
</body>
</html>
