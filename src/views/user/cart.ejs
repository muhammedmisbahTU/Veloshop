<div class="max-w-7xl mx-auto px-5 py-10">


<h1 class="text-3xl font-bold mb-8">
Shopping Cart
</h1>



<% if(cartItems.length === 0){ %>
<div class="text-center py-20 bg-zinc-900 border border-white/5 rounded-3xl">
    <svg class="w-16 h-16 text-zinc-700 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
    </svg>
    <h3 class="text-lg font-bold text-white mb-2">Your cart is empty.</h3>
    <p class="text-sm text-zinc-500 max-w-sm mx-auto mb-6">Explore our products and add them to your cart!</p>
    <a href="/shop" class="px-6 py-3 bg-lime-400 hover:bg-lime-300 text-black font-black text-sm rounded-xl transition duration-300">
        Continue Shopping
    </a>
</div>


<% } else { %>



<div class="space-y-5">
<% cartItems.forEach(item=>{ %>
<div class="flex gap-5 bg-zinc-900 p-5 rounded-xl <%= item.isUnavailable ? 'border border-red-500/20 opacity-60' : '' %>">
    <img src="<%= item.variant.images[0] %>" class="w-32 h-32 object-cover rounded-xl bg-black">

    <div class="flex-1 min-w-0">
        <div class="flex items-center justify-between gap-4">
            <h2 class="text-xl font-bold text-white truncate">
                <%= item.product.name %>
            </h2>
            <% if (item.isUnavailable) { %>
                <span class="text-xs bg-red-500/10 border border-red-500/30 text-red-500 font-black uppercase tracking-wider px-2 py-0.5 rounded">Unavailable</span>
            <% } %>
        </div>

        <p class="text-zinc-400">
            <%= item.product.brand %>
        </p>

        <div class="flex items-center gap-3 mt-3">
            <button
                onclick="updateQuantity('<%= item.variant._id %>', -1)"
                <%= item.isUnavailable ? 'disabled' : '' %>
                class="px-3 py-1 bg-zinc-800 rounded hover:bg-zinc-700 disabled:opacity-50 disabled:cursor-not-allowed">
                -
            </button>

            <span id="qty-<%= item.variant._id %>">
                <%= item.quantity %>
            </span>

            <button
                onclick="updateQuantity('<%= item.variant._id %>', 1)"
                <%= item.isUnavailable ? 'disabled' : '' %>
                class="px-3 py-1 bg-zinc-800 rounded hover:bg-zinc-700 disabled:opacity-50 disabled:cursor-not-allowed">
                +
            </button>
        </div>

        <p class="mt-2">
            Price: ₹<%= item.price %>
        </p>

        <p>
            Subtotal: ₹<%= item.subtotal %>
        </p>
    </div>
</div>

<button
    onclick="removeItem('<%= item.variant._id %>')"
    class="text-red-500 hover:text-red-400 font-semibold mb-6 block">
    Remove
</button>
<% }) %>
</div>

<div class="mt-10">
    <h2 class="text-2xl font-bold">
        Total: ₹<%= total %>
    </h2>

    <button
        <% if (hasUnavailable) { %>
            onclick="Swal.fire({ icon: 'warning', title: 'Action Required', text: 'Please remove unavailable items before placing your order.', confirmButtonColor: '#84cc16' })"
        <% } else { %>
            onclick="window.location.href='/checkout'"
        <% } %>
        class="mt-5 bg-lime-400 hover:bg-lime-300 text-black px-8 py-3 rounded-xl font-bold transition">
        Checkout
    </button>
</div>
<% } %>


</div>

<script>
    async function updateQuantity(variantId, change){


const response = await fetch(
"/cart",
{

method:"PATCH",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({

variantId,

change

})

});


const data = await response.json();



if(!data.success){

Swal.fire({

icon:"error",

title:"Error",

text:data.message

});

return;

}


location.reload();


}

async function removeItem(variantId){


const result = await Swal.fire({

title:"Remove item?",

icon:"warning",

showCancelButton:true,

confirmButtonText:"Remove"

});


if(!result.isConfirmed)
return;



const response = await fetch(
`/cart/${variantId}`,
{

method:"DELETE"

});



const data = await response.json();



if(data.success){

location.reload();

}



}
</script>