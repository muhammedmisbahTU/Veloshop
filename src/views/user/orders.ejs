<div class="max-w-7xl mx-auto px-5 py-10">

    <!-- Header -->
    <div class="mb-8">

        <h1 class="text-3xl font-bold text-white">
            My Orders
        </h1>

        <p class="text-zinc-400 mt-2">
            Track and manage your recent purchases
        </p>

    </div>

    <div class="bg-zinc-900 rounded-2xl p-5 mb-6">


<form action="/orders/search" method="GET"
class="flex gap-3">


<input

type="text"

name="search"

value="<%= search || '' %>"

placeholder="Search Order ID or Product..."

class="flex-1 bg-zinc-800 border border-white/10 
rounded-xl px-4 py-3 text-white 
focus:outline-none focus:border-lime-400"


>


<button

type="submit"

class="bg-lime-400 hover:bg-lime-300 
text-black px-6 rounded-xl font-semibold">

Search

</button>


</form>


</div>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
async function retryPayment(orderId) {
    try {
        const response = await fetch(`/payment/retry/${orderId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();

        if (data.success && data.paymentRequired) {
            const options = {
                key: data.keyId,
                amount: data.amount,
                currency: data.currency,
                name: "Veloshop",
                description: "Retry Payment",
                order_id: data.razorpayOrderId,
                handler: async function (response) {
                    try {
                        const verifyRes = await fetch("/payment/verify", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                orderId: data.orderId,
                                razorpay_order_id: response.razorpay_order_id,
                                razorpay_payment_id: response.razorpay_payment_id,
                                razorpay_signature: response.razorpay_signature
                            })
                        });
                        const verifyData = await verifyRes.json();
                        if (verifyData.success) {
                            window.location.href = `/order-success/${data.orderId}`;
                        } else {
                            window.location.href = `/payment-failure/${data.orderId}?message=${encodeURIComponent(verifyData.message || "Payment verification failed")}`;
                        }
                    } catch (e) {
                        window.location.href = `/payment-failure/${data.orderId}?message=VerificationRequestError`;
                    }
                },
                modal: {
                    ondismiss: function () {
                        fetch(`/payment/cancel/${data.orderId}`, { method: "POST" })
                            .finally(() => {
                                window.location.href = `/payment-failure/${data.orderId}?message=PaymentCancelledByUser`;
                            });
                    }
                },
                theme: { color: "#a3e635" }
            };
            const rzp = new Razorpay(options);
            rzp.open();
        } else {
            Swal.fire({
                icon: "error",
                title: "Cannot retry payment",
                text: data.message || "Failed to initialize payment gateway."
            });
        }
    } catch (err) {
        Swal.fire({
            icon: "error",
            title: "Error",
            text: "Network error while retrying payment."
        });
    }
}
</script>


    <% if(orders && orders.length > 0){ %>


    <div class="space-y-6">


        <% orders.forEach(order => { %>


        <div class="bg-zinc-900 border border-white/10 rounded-2xl p-6">


            <!-- Top Section -->

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5">


                <div>

                    <p class="text-sm text-zinc-400">
                        Order ID
                    </p>

                    <h2 class="text-lg font-semibold text-white whitespace-nowrap">
                        <%= order.orderNumber %>
                    </h2>


                    <p class="text-sm text-zinc-500 mt-2">

                        Placed on
                        <%= new Date(order.createdAt).toLocaleDateString("en-US", {
                            day:"2-digit",
                            month:"short",
                            year:"numeric"
                        }) %>

                    </p>


                </div>



                <!-- Status -->

                <div>


                    <% 
                    let statusColor = "bg-yellow-400/20 text-yellow-400 border border-yellow-500/20";

                    if(order.status === "CONFIRMED"){
                        statusColor = "bg-lime-400/20 text-lime-400 border border-lime-500/20";
                    }

                    if(order.status === "PROCESSING"){
                        statusColor = "bg-blue-400/20 text-blue-400 border border-blue-500/20";
                    }

                    if(order.status === "SHIPPED"){
                        statusColor = "bg-purple-400/20 text-purple-400 border border-purple-500/20";
                    }

                    if(order.status === "DELIVERED"){
                        statusColor = "bg-green-400/20 text-green-400 border border-green-500/20";
                    }

                    if(order.status === "CANCELLED" || order.status === "PAYMENT_FAILED"){
                        statusColor = "bg-red-400/20 text-red-400 border border-red-500/20";
                    }

                    if(order.status === "RETURNED"){
                        statusColor = "bg-purple-500/10 text-purple-400 border border-purple-500/20";
                    }

                    %>


                    <span class="px-4 py-2 rounded-full text-sm font-semibold whitespace-nowrap <%= statusColor %>">

                        <%= order.status %>

                    </span>


                </div>


            </div>



            <hr class="border-zinc-800 my-6">



            <!-- Order Content -->


            <div class="flex flex-col lg:flex-row gap-6">


                <!-- Product Preview -->


                <div class="flex-1">


                    <div class="flex gap-4">


                        <% if(order.items.length){ %>


                        <img
                            src="<%= order.items[0].thumbnail %>"
                            class="w-20 h-20 rounded-xl object-cover border border-white/10">


                        <% } %>


                        <div>


                            <h3 class="text-white font-semibold">

                                <%= order.items[0].productName %>

                            </h3>


                            <p class="text-zinc-400 text-sm mt-1">

                                <%= order.items.length %> item(s)

                            </p>


                            <p class="text-zinc-400 text-sm">

                                Payment :
                                <span class="text-white">
                                    <%= order.paymentMethod %>
                                </span>

                            </p>


                        </div>


                    </div>


                </div>



                <!-- Price -->


                <div class="flex flex-col justify-center">


                    <p class="text-sm text-zinc-400">
                        Total Amount
                    </p>


                    <p class="text-2xl font-bold text-lime-400">

                        ₹<%= order.grandTotal.toFixed(2) %>

                    </p>


                </div>



                <!-- Button -->


                <div class="flex items-center gap-3">
                    <% if (order.status === "PAYMENT_FAILED" || (order.paymentMethod === "ONLINE" && order.paymentStatus === "FAILED")) { %>
                        <button
                            onclick="retryPayment('<%= order._id %>')"
                            class="bg-blue-500 hover:bg-blue-400 transition text-white font-semibold px-6 py-3 rounded-xl">
                            Retry Payment
                        </button>
                    <% } %>

                    <a
                        href="/orders/<%= order._id %>"
                        class="bg-lime-400 hover:bg-lime-300 transition text-black font-semibold px-6 py-3 rounded-xl">

                        View Details

                    </a>

                </div>


            </div>



        </div>


        <% }) %>


    </div>


    <% } else { %>



    <!-- Empty State -->


    <div class="bg-zinc-900 border border-white/10 rounded-2xl p-10 text-center">


        <div class="w-20 h-20 mx-auto rounded-full bg-zinc-800 flex items-center justify-center mb-5">

            <svg 
                xmlns="http://www.w3.org/2000/svg"
                class="w-10 h-10 text-zinc-500"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor">

                <path 
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 3h18v18H3V3z"/>

            </svg>

        </div>


        <h2 class="text-xl font-semibold text-white mb-2">

            No Orders Found

        </h2>


        <p class="text-zinc-400 mb-6">

            You haven't placed any orders yet.

        </p>


        <a
            href="/shop"
            class="inline-block bg-lime-400 hover:bg-lime-300 text-black font-semibold px-8 py-3 rounded-xl">

            Start Shopping

        </a>


    </div>



    <% } %>


</div>