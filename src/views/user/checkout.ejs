<div class="max-w-7xl mx-auto px-5 py-10">

    <h1 class="text-3xl font-bold text-white mb-8">
        Checkout
    </h1>

    <div class="grid lg:grid-cols-3 gap-8">

        <!-- Left Section -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Shipping Address -->
            <div class="bg-zinc-900 rounded-2xl p-6">

            <div class="flex justify-between items-center mb-5">
                <h2 class="text-xl font-semibold text-white">
                    Shipping Address
                </h2>

                <button id="showAddFormBtn" class="text-lime-400 text-sm font-semibold hover:underline">
                        + Add Address
                    </button>
            </div>

            <div id="address-alert-container" class="hidden rounded-xl p-4 text-sm mb-5 text-center"></div>

            <form id="addAddressForm" class="hidden space-y-4 bg-black/40 border border-white/5 p-5 rounded-2xl mb-8" novalidate>
                    <h3 class="font-bold text-white mb-2">New Address Details</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="text-xs text-gray-400">Address Line 1</label>
                            <input id="addressLine1" type="text" name="addressLine1" placeholder="Street address, P.O. Box" class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none" required>
                        </div>
                        <div>
                            <label class="text-xs text-gray-400">Address Line 2 (Optional)</label>
                            <input type="text" name="addressLine2" placeholder="Apartment, suite, unit, building" class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none">
                        </div>
                    </div>

                    <div>
                        <label class="text-xs text-gray-400">Phone Number</label>
                        <input
                            id="phone"
                            type="tel"
                            name="phone"
                            placeholder="Enter phone number"
                            class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none"
                            required
                        >
                    </div>


                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                        <div class="sm:col-span-2">
                            <label class="text-xs text-gray-400">City</label>
                            <input id="city" type="text" name="city" placeholder="City" class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none" required>
                        </div>
                        <div>
                            <label class="text-xs text-gray-400">State / Region</label>
                            <input id="state" type="text" name="state" placeholder="State" class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none" required>
                        </div>
                        <div>
                            <label class="text-xs text-gray-400">PIN / Zip Code</label>
                            <input id="pinCode" type="number" name="pinCode" placeholder="Code" class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none" required>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="text-xs text-gray-400">Country</label>
                            <input id="country" type="text" name="country" placeholder="Country" class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none" required>
                        </div>
                        <div class="flex items-center gap-2 pt-6">
                            <input type="checkbox" name="IsDefault" value="true" id="isDefaultCheck" class="accent-lime-400 w-4 h-4">
                            <label for="isDefaultCheck" class="text-sm text-gray-300 cursor-pointer">Set as default address</label>
                        </div>
                    </div>

                    <div class="flex justify-end gap-3 pt-4 border-t border-white/5">
                        <button type="button" id="cancelAddBtn" class="px-4 py-2 border border-white/10 hover:border-white/30 text-gray-300 text-sm rounded-lg">
                            Cancel
                        </button>
                        <button type="submit" class="px-4 py-2 bg-lime-400 hover:bg-lime-300 text-black font-semibold text-sm rounded-lg transition">
                            Save Address
                        </button>
                    </div>
                </form>

            <% if(addresses && addresses.length){ %>

                <% addresses.forEach((address,index)=>{ %>

                    <label
                        class="flex gap-4 items-start bg-zinc-800 rounded-xl p-4 cursor-pointer hover:bg-zinc-700 transition mb-4">

                        <input
                            type="radio"
                            name="address"
                            value="<%= address._id %>"
                            <%= address.IsDefault || index === 0 ? "checked" : "" %>
                            class="mt-1 accent-lime-400">

                        <div>

                            <div class="flex items-center gap-2">
                                <h3 class="font-semibold text-white">
                                    Address <%= index + 1 %>
                                </h3>

                                <% if(address.IsDefault){ %>
                                    <span class="text-xs bg-lime-400 text-black px-2 py-1 rounded">
                                        Default
                                    </span>
                                <% } %>
                            </div>

                            <p class="text-zinc-400 text-sm mt-1">
                                <%= address.addressLine1 %>
                                <% if(address.addressLine2){ %>
                                    , <%= address.addressLine2 %>
                                <% } %>,
                                📞 <%= address.phone %>,
                                <%= address.city %>,
                                <%= address.state %>,
                                <%= address.pinCode %>,
                                <%= address.country %>
                            </p>

                        </div>
                         <button
                            type="button"
                            class="edit-address-btn text-lime-400 hover:text-lime-300"

                            data-id="<%= address._id %>"
                            data-address-line1="<%= address.addressLine1 %>"
                            data-address-line2="<%= address.addressLine2 || '' %>"
                            data-phone="<%= address.phone %>"
                            data-city="<%= address.city %>"
                            data-state="<%= address.state %>"
                            data-pincode="<%= address.pinCode %>"
                            data-country="<%= address.country %>"
                            data-default="<%= address.IsDefault ? 'true' : 'false' %>">

                            Edit

                        </button>

                    </label>

                <% }) %>

            <% } else { %>

                <div class="text-center py-8">

                    <p class="text-zinc-400 mb-5">
                        No address found.
                    </p>

                    <button type="button" id="emptyAddAddressBtn"
                        class="bg-lime-400 text-black px-6 py-3 rounded-xl font-semibold hover:bg-lime-300 transition">
                        Add Address
                    </button>

                </div>

            <% } %>

        </div>


            <!-- Payment -->
            <div class="bg-zinc-900 rounded-2xl p-6">

                <h2 class="text-xl font-semibold text-white mb-5">
                    Payment Method
                </h2>

                <div class="space-y-4">

                    <label class="flex items-center gap-4 bg-zinc-800 p-4 rounded-xl cursor-pointer hover:bg-zinc-700">
                        <input
                            type="radio"
                            name="payment"
                            value="COD"
                            class="accent-lime-400">
                        <span>
                            Cash on Delivery
                        </span>
                    </label>

                    <label class="flex items-center gap-4 bg-zinc-800 p-4 rounded-xl cursor-pointer hover:bg-zinc-700">
                        <input
                            type="radio"
                            name="payment"
                            value="ONLINE"
                            checked
                            class="accent-lime-400">
                        <span>
                            Online Payment
                        </span>
                    </label>

                    <!-- Wallet Options -->
                    <div class="bg-zinc-800 p-4 rounded-xl border border-white/5 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium text-white flex items-center gap-2">
                                💳 Wallet Balance: <span class="text-lime-400 font-bold">₹<%= wallet.balance.toFixed(2) %></span>
                            </span>
                            <% if (wallet.balance > 0) { %>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="useWalletCheckbox" class="sr-only peer" onchange="toggleWalletUsage()">
                                    <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-lime-400"></div>
                                    <span class="ml-2 text-xs font-medium text-zinc-400">Use Wallet</span>
                                </label>
                            <% } else { %>
                                <span class="text-xs text-zinc-500">Empty Wallet</span>
                            <% } %>
                        </div>
                        <div id="walletDeductionInfo" class="hidden text-xs text-zinc-400 bg-black/30 p-2.5 rounded-lg space-y-1">
                            <div class="flex justify-between">
                                <span>Wallet deduction:</span>
                                <span class="text-lime-400 font-semibold" id="walletDeductedAmount">-₹0.00</span>
                            </div>
                            <div class="flex justify-between font-medium text-white pt-1 border-t border-white/5">
                                <span>Remaining to pay:</span>
                                <span id="walletRemainingAmount">₹<%= grandTotal.toFixed(2) %></span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- Order Summary -->
        <div>

            <div class="bg-zinc-900 rounded-2xl p-6 sticky top-24">

                <h2 class="text-xl font-bold text-white mb-6">
                    Order Summary
                </h2>

                <% cartItems.items.forEach(item=>{ %>

                    <div class="flex gap-4 mb-5">

                        <img
                            src="<%= item.variantId.images[0] %>"
                            class="w-16 h-16 rounded-lg object-cover">

                        <div class="flex-1">

                            <h3 class="font-medium">
                                <%= item.productId.name %>
                            </h3>

                            <p class="text-zinc-400 text-sm">
                                Qty :
                                <%= item.quantity %>
                            </p>

                            <p class="text-sm text-zinc-400">
                                ₹<%= item.variantId.salePrice %> × <%= item.quantity %>
                            </p>

                        </div>

                        <span class="font-semibold">
                            ₹<%= item.subtotal %>
                        </span>

                        

                    </div>

                <% }) %>

                <hr class="border-zinc-700 my-5">

                <!-- Coupon Section -->
                <div class="mb-6">

                    <label class="text-sm text-zinc-400 mb-2 block">
                        Have a coupon?
                    </label>

                    <% if (typeof coupon !== 'undefined' && coupon && coupon.code) { %>
                        <div class="bg-lime-400/10 border border-lime-400/30 rounded-xl p-4 flex items-center justify-between">
                            <div>
                                <p class="text-xs text-zinc-400 font-semibold uppercase tracking-wider">Applied Coupon</p>
                                <p class="text-lg font-bold text-lime-400"><%= coupon.code %></p>
                                <p class="text-xs text-zinc-300">Discount of ₹<%= coupon.discount %> applied</p>
                            </div>
                            <button
                                id="removeCouponBtn"
                                type="button"
                                class="px-3 py-1.5 bg-red-500/10 border border-red-500/30 hover:bg-red-500/20 text-red-400 font-bold rounded-lg text-xs transition"
                            >
                                Remove
                            </button>
                        </div>
                    <% } else { %>
                        <div class="flex gap-2">
                            <input
                                type="text"
                                id="couponCode"
                                placeholder="Enter coupon code"
                                class="flex-1 bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-sm text-white outline-none focus:border-lime-400 placeholder:text-zinc-500"
                            >
                            <button
                                id="applyCoupon"
                                type="button"
                                class="px-5 py-3 bg-lime-400 hover:bg-lime-300 text-black font-bold rounded-xl transition"
                            >
                                Apply
                            </button>
                        </div>
                        <button type="button" id="viewCouponsBtn" class="text-xs text-lime-400 hover:text-lime-300 font-semibold underline mt-2 block">View available coupons</button>
                    <% } %>

                    <p 
                        id="couponMessage"
                        class="hidden mt-3 text-sm rounded-lg px-3 py-2"
                    ></p>

                </div>

                <div class="space-y-3">
                <div class="flex justify-between">
                    <span class="text-zinc-400">Subtotal</span>
                    <span>₹<%= subtotal %></span>
                </div>

                

                <div class="flex justify-between">
                    <span class="text-zinc-400">Discount</span>
                    <span class="text-red-400">-₹<%= discount %></span>
                </div>

                <div class="flex justify-between">
                    <span class="text-zinc-400">Tax</span>
                    <span>₹<%= tax %></span>
                </div>

                <div class="flex justify-between">
                    <span class="text-zinc-400">Shipping</span>

                    <% if(shipping === 0){ %>
                        <span class="text-lime-400">Free</span>
                    <% } else { %>
                        <span>₹<%= shipping %></span>
                    <% } %>
                </div>

                <div class="flex justify-between text-xl font-bold border-t border-zinc-700 pt-3">
                    <span>Total</span>
                    <span class="text-lime-400">
                        ₹<%= grandTotal %>
                    </span>
                </div>

                </div>

                <button
                    onclick="placeOrder()"
                    class="w-full mt-8 bg-lime-400 hover:bg-lime-300 transition text-black font-bold py-4 rounded-xl">

                    Place Order

                </button>

            </div>

        </div>

    </div>

</div>


<div id="editAddressModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 px-4">
    <div class="w-full max-w-2xl border border-white/10 bg-zinc-950 p-6 shadow-2xl">
        <div class="mb-5 flex items-center justify-between gap-4">
            <h3 class="text-xl font-bold text-white">Edit Address</h3>
            <button id="closeEditModalBtn" type="button" class="text-sm font-semibold text-gray-400 hover:text-white">Close</button>
        </div>

        <form id="editAddressForm" class="space-y-4" novalidate>
            <input type="hidden" name="id" id="editAddressId">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="text-xs text-gray-400">Address Line 1</label>
                    <input type="text" name="addressLine1" id="editAddressLine1" class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none" required>
                </div>
                <div>
                    <label class="text-xs text-gray-400">Address Line 2</label>
                    <input type="text" name="addressLine2" id="editAddressLine2" class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none">
                </div>
            </div>

            <div>
                <label class="text-xs text-gray-400">Phone Number</label>
                <input
                    type="tel"
                    name="phone"
                    id="editPhone"
                    class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none"
                    required
                >
            </div>


            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                <div class="sm:col-span-2">
                    <label class="text-xs text-gray-400">City</label>
                    <input type="text" name="city" id="editCity" class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none" required>
                </div>
                <div>
                    <label class="text-xs text-gray-400">State</label>
                    <input type="text" name="state" id="editState" class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none" required>
                </div>
                <div>
                    <label class="text-xs text-gray-400">PIN Code</label>
                    <input type="number" name="pinCode" id="editPinCode" class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none" required>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="text-xs text-gray-400">Country</label>
                    <input type="text" name="country" id="editCountry" class="w-full mt-1 bg-zinc-900 border border-white/10 rounded-xl p-3 text-sm focus:border-lime-400 focus:outline-none" required>
                </div>
                <div class="flex items-center gap-2 pt-6">
                    <input type="checkbox" name="IsDefault" value="true" id="editIsDefault" class="accent-lime-400 w-4 h-4">
                    <label for="editIsDefault" class="text-sm text-gray-300 cursor-pointer">Set as default address</label>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-white/5">
                <button type="button" id="cancelEditAddressBtn" class="px-4 py-2 border border-white/10 hover:border-white/30 text-gray-300 text-sm rounded-lg">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-lime-400 hover:bg-lime-300 text-black font-semibold text-sm rounded-lg transition">Update Address</button>
            </div>
        </form>
    </div>
</div>

<script>
let originalGrandTotal = <%= grandTotal %>;
let walletBalance = <%= wallet.balance %>;

function toggleWalletUsage() {
    const useWallet = document.getElementById("useWalletCheckbox")?.checked;
    const infoDiv = document.getElementById("walletDeductionInfo");
    const codLabel = document.querySelector("input[name='payment'][value='COD']")?.closest('label');

    if (useWallet) {
        infoDiv.classList.remove("hidden");
        const deduction = Math.min(walletBalance, originalGrandTotal);
        const remaining = originalGrandTotal - deduction;

        document.getElementById("walletDeductedAmount").textContent = `-₹${deduction.toFixed(2)}`;
        document.getElementById("walletRemainingAmount").textContent = `₹${remaining.toFixed(2)}`;

        if (remaining <= 0) {
            // Full Wallet payment: hide other standard payment methods / disable COD
            if (codLabel) codLabel.style.display = 'none';
            // Auto select ONLINE (it will be bypassed on backend anyway)
            const onlineRadio = document.querySelector("input[name='payment'][value='ONLINE']");
            if (onlineRadio) onlineRadio.checked = true;
        } else {
            if (codLabel) codLabel.style.display = 'flex';
        }
    } else {
        infoDiv.classList.add("hidden");
        if (codLabel) codLabel.style.display = 'flex';
    }
}

async function placeOrder(){

    const address=document.querySelector("input[name='address']:checked")?.value;
    const payment=document.querySelector("input[name='payment']:checked")?.value;
    const useWallet=document.getElementById("useWalletCheckbox")?.checked || false;

    if(!address){
        return Swal.fire({
            icon:"warning",
            title:"Select Address"
        });
    }

    const response=await fetch("/checkout/place-order",{
        method:"POST",
        headers:{
            "Content-Type":"application/json"
        },
        body:JSON.stringify({
            addressId:address,
            paymentMethod:payment,
            useWallet:useWallet
        })
    });

    const data=await response.json();

    if (data.success) {
        if (data.paymentRequired) {
            const options = {
                key: data.keyId,
                amount: data.amount,
                currency: data.currency,
                name: "Veloshop",
                description: "Purchase Payment",
                order_id: data.razorpayOrderId,
                handler: async function (response) {
                    try {
                        const verifyRes = await fetch("/payment/verify", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                orderId: data.orderId,
                                razorpay_order_id: response.razorpay_order_id,
                                razorpay_payment_id: response.razorpay_payment_id,
                                razorpay_signature: response.razorpay_signature
                            })
                        });
                        const verifyData = await verifyRes.json();
                        if (verifyData.success) {
                            window.location.href = `/order-success/${data.orderId}`;
                        } else {
                            window.location.href = `/payment-failure/${data.orderId}?message=${encodeURIComponent(verifyData.message || "Payment verification failed")}`;
                        }
                    } catch (e) {
                        window.location.href = `/payment-failure/${data.orderId}?message=VerificationRequestError`;
                    }
                },
                modal: {
                    ondismiss: function () {
                        // Mark order payment status as failed and redirect
                        fetch(`/payment/cancel/${data.orderId}`, { method: "POST" })
                            .finally(() => {
                                window.location.href = `/payment-failure/${data.orderId}?message=PaymentCancelledByUser`;
                            });
                    }
                },
                theme: { color: "#a3e635" }
            };
            const rzp = new Razorpay(options);
            rzp.open();
        } else {
            window.location.href = `/order-success/${data.orderId}`;
        }
    }else{
        Swal.fire({
            icon:"error",
            title:"Order Failed",
            text:data.message
        });
    }
}

const showAddFormBtn = document.getElementById("showAddFormBtn");
const cancelAddBtn = document.getElementById("cancelAddBtn");
const addAddressForm = document.getElementById("addAddressForm");
const addressAlert = document.getElementById("address-alert-container");
const editAddressModal = document.getElementById("editAddressModal");
const editAddressForm = document.getElementById("editAddressForm");
const closeEditModalBtn = document.getElementById("closeEditModalBtn");
const cancelEditAddressBtn = document.getElementById("cancelEditAddressBtn");

function openEditModal(button) {
    document.getElementById("editAddressId").value = button.dataset.id;
    document.getElementById("editAddressLine1").value = button.dataset.addressLine1 || "";
    document.getElementById("editAddressLine2").value = button.dataset.addressLine2 || "";
    document.getElementById("editPhone").value = button.dataset.phone || "";
    document.getElementById("editCity").value = button.dataset.city || "";
    document.getElementById("editState").value = button.dataset.state || "";
    document.getElementById("editPinCode").value = button.dataset.pincode || "";
    document.getElementById("editCountry").value = button.dataset.country || "";
    document.getElementById("editIsDefault").checked = button.dataset.default === "true";
    editAddressModal.classList.remove("hidden");
    editAddressModal.classList.add("flex");
}

function closeEditModal() {
    editAddressModal.classList.add("hidden");
    editAddressModal.classList.remove("flex");
    editAddressForm.reset();
}

showAddFormBtn.addEventListener("click", () => {
    addAddressForm.classList.remove("hidden");
    showAddFormBtn.classList.add("hidden");
});

const emptyAddAddressBtn = document.getElementById("emptyAddAddressBtn");
if (emptyAddAddressBtn) {
    emptyAddAddressBtn.addEventListener("click", () => {
        addAddressForm.classList.remove("hidden");
        if (showAddFormBtn) {
            showAddFormBtn.classList.add("hidden");
        }
        addAddressForm.scrollIntoView({ behavior: 'smooth' });
    });
}

cancelAddBtn.addEventListener("click", () => {
    addAddressForm.classList.add("hidden");
    showAddFormBtn.classList.remove("hidden");
    addAddressForm.reset();
});

const addressValidation = new JustValidate("#addAddressForm");


addressValidation

.addField("#addressLine1", [
    {
        rule: "required",
        errorMessage: "Address line 1 is required",
    },
    {
        rule: "minLength",
        value: 5,
        errorMessage: "Address is too short",
    },
])

.addField('#phone', [
  {
    rule: 'required',
    errorMessage: 'Phone number is required',
  },
  {
    validator: (value) => /^[6-9]\d{9}$/.test(value.trim()),
    errorMessage: 'Enter a valid 10-digit phone number',
  },
])


.addField("#city", [
    {
        rule: "required",
        errorMessage: "City is required",
    },
])

.addField("#state", [
    {
        rule: "required",
        errorMessage: "State is required",
    },
])

.addField("#pinCode", [
    {
        rule: "required",
        errorMessage: "PIN code is required",
    },
    {
        rule: "number",
        errorMessage: "PIN code must be a number",
    },
])

.addField("#country", [
    {
        rule: "required",
        errorMessage: "Country is required",
    },
])


.onSuccess(async (event)=>{

    event.preventDefault();
    addressAlert.classList.add("hidden");
    addressAlert.className = "rounded-xl p-4 text-sm mb-5 text-center";

    const formData = new FormData(addAddressForm);
    const data = Object.fromEntries(formData.entries());
    // checkbox handling
    data.IsDefault = formData.get("IsDefault") === "true";

    try {
        const response = await fetch("/addresses", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        if (response.ok && result.success) {
            addressAlert.classList.remove("hidden");
            addressAlert.classList.add("bg-lime-500/10", "border", "border-lime-500/30", "text-lime-400");
            addressAlert.textContent = result.message || "Address added successfully!";
            setTimeout(() => {
                window.location.reload();
            }, 1000);
        } else {
            addressAlert.classList.remove("hidden");
            addressAlert.classList.add("bg-red-500/10", "border", "border-red-500/30", "text-red-400");
            addressAlert.textContent = result.message || "Failed to add address.";
        }
    } catch (err) {
        addressAlert.classList.remove("hidden");
        addressAlert.classList.add("bg-red-500/10", "border", "border-red-500/30", "text-red-400");
        addressAlert.textContent = "A network error occurred. Please try again.";
    }
});

document.querySelectorAll(".edit-address-btn").forEach(btn => {
    btn.addEventListener("click", () => openEditModal(btn));
});

closeEditModalBtn.addEventListener("click", closeEditModal);
cancelEditAddressBtn.addEventListener("click", closeEditModal);

editAddressModal.addEventListener("click", (e) => {
    if (e.target === editAddressModal) {
        closeEditModal();
    }
});

const editAddressValidation = new JustValidate("#editAddressForm");


editAddressValidation

.addField("#editAddressLine1", [
    {
        rule: "required",
        errorMessage: "Address Line 1 is required",
    },
    {
        rule: "minLength",
        value: 5,
        errorMessage: "Address is too short",
    },
])

.addField("#editPhone", [
{
    rule: "required",
    errorMessage: "Phone number is required",
},
{
    validator: (value) => /^[6-9]\d{9}$/.test(value),
    errorMessage: "Enter a valid 10-digit phone number",
},
])


.addField("#editCity", [
    {
        rule: "required",
        errorMessage: "City is required",
    },
])

.addField("#editState", [
    {
        rule: "required",
        errorMessage: "State is required",
    },
])

.addField("#editPinCode", [
    {
        rule: "required",
        errorMessage: "PIN code is required",
    },
    {
        rule: "number",
        errorMessage: "PIN code must contain numbers only",
    },
])

.addField("#editCountry", [
    {
        rule: "required",
        errorMessage: "Country is required",
    },
])


.onSuccess(async (event)=>{

    event.preventDefault();
    addressAlert.classList.add("hidden");
    addressAlert.className = "rounded-xl p-4 text-sm mb-5 text-center";

    const id = document.getElementById("editAddressId").value;
    const formData = new FormData(editAddressForm);
    const data = Object.fromEntries(formData.entries());
    data.IsDefault = formData.get("IsDefault") === "true";
    delete data.id;

    try {
        const response = await fetch(`/addresses/edit/${id}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        if (response.ok && result.success) {
            addressAlert.classList.remove("hidden");
            addressAlert.classList.add("bg-lime-500/10", "border", "border-lime-500/30", "text-lime-400");
            addressAlert.textContent = result.message || "Address updated successfully.";
            closeEditModal();
            setTimeout(() => {
                window.location.reload();
            }, 1000);
        } else {
            addressAlert.classList.remove("hidden");
            addressAlert.classList.add("bg-red-500/10", "border", "border-red-500/30", "text-red-400");
            addressAlert.textContent = result.message || "Failed to update address.";
        }
    } catch (err) {
        addressAlert.classList.remove("hidden");
        addressAlert.classList.add("bg-red-500/10", "border", "border-red-500/30", "text-red-400");
        addressAlert.textContent = "A network error occurred. Please try again.";
    }
});

const applyBtn = document.getElementById("applyCoupon");
if (applyBtn) {
    applyBtn.addEventListener("click", async()=>{
        const code = document
        .getElementById("couponCode")
        .value
        .trim();


    const message = document.getElementById("couponMessage");


    if(!code){

        message.className =
        "mt-3 text-sm rounded-lg px-3 py-2 bg-red-500/10 border border-red-500/30 text-red-400";

        message.textContent = "Please enter coupon code";
        message.classList.remove("hidden");

        return;
    }


    try{

        const res = await fetch("/checkout/apply-coupon",{

            method:"POST",

            headers:{
                "Content-Type":"application/json"
            },

            body:JSON.stringify({
                code
            })

        });


        const data = await res.json();


        if(data.success){

            message.className =
            "mt-3 text-sm rounded-lg px-3 py-2 bg-lime-500/10 border border-lime-500/30 text-lime-400";


            message.textContent =
            data.message || "Coupon applied successfully";


            message.classList.remove("hidden");


            setTimeout(()=>{
                location.reload();
            },800);


        }else{


            message.className =
            "mt-3 text-sm rounded-lg px-3 py-2 bg-red-500/10 border border-red-500/30 text-red-400";


            message.textContent =
            data.message || "Invalid coupon";


            message.classList.remove("hidden");

        }


    }catch(error){

        message.className =
        "mt-3 text-sm rounded-lg px-3 py-2 bg-red-500/10 border border-red-500/30 text-red-400";


        message.textContent =
        "Something went wrong. Try again.";

        message.classList.remove("hidden");

    }
});
}

const removeBtn = document.getElementById("removeCouponBtn");
if (removeBtn) {
    removeBtn.addEventListener("click", async () => {
        try {
            const res = await fetch("/checkout/remove-coupon", {
                method: "POST",
                headers: { "Content-Type": "application/json" }
            });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                Swal.fire({ icon: "error", title: "Error", text: data.message || "Failed to remove coupon." });
            }
        } catch (e) {
            Swal.fire({ icon: "error", title: "Error", text: "Something went wrong. Please try again." });
        }
    });
}

document.addEventListener("DOMContentLoaded", () => {
    const viewCouponsBtn = document.getElementById("viewCouponsBtn");
    const couponsModal = document.getElementById("couponsModal");
    const closeCouponsModalBtn = document.getElementById("closeCouponsModalBtn");

    if (viewCouponsBtn && couponsModal) {
        viewCouponsBtn.addEventListener("click", () => {
            couponsModal.classList.remove("hidden");
            couponsModal.classList.add("flex");
        });
    }

    if (closeCouponsModalBtn) {
        closeCouponsModalBtn.addEventListener("click", closeCouponsModal);
    }

    if (couponsModal) {
        couponsModal.addEventListener("click", (e) => {
            if (e.target === couponsModal) {
                closeCouponsModal();
            }
        });
    }
});

function closeCouponsModal() {
    const couponsModal = document.getElementById("couponsModal");
    if (couponsModal) {
        couponsModal.classList.add("hidden");
        couponsModal.classList.remove("flex");
    }
}

function selectCoupon(code) {
    const codeInput = document.getElementById("couponCode");
    if (codeInput) {
        codeInput.value = code;
    }
    closeCouponsModal();
    const applyBtn = document.getElementById("applyCoupon");
    if (applyBtn) {
        applyBtn.click();
    }
}
</script>

<!-- Available Coupons Modal -->
<div id="couponsModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 px-4">
    <div class="w-full max-w-lg border border-white/10 bg-zinc-950 p-6 shadow-2xl rounded-2xl">
        <div class="mb-5 flex items-center justify-between gap-4">
            <h3 class="text-xl font-bold text-white">Available Coupons</h3>
            <button id="closeCouponsModalBtn" type="button" class="text-sm font-semibold text-gray-400 hover:text-white">Close</button>
        </div>

        <div class="space-y-4 max-h-96 overflow-y-auto pr-2">
            <% if (typeof coupons !== 'undefined' && coupons && coupons.length > 0) { %>
                <% coupons.forEach(c => { %>
                    <div class="p-4 bg-zinc-900 border border-white/5 rounded-xl flex items-center justify-between gap-4">
                        <div class="min-w-0">
                            <span class="inline-block bg-lime-400/20 text-lime-400 text-xs font-black px-2 py-0.5 rounded mb-1 uppercase tracking-wider"><%= c.code %></span>
                            <p class="text-sm font-semibold text-white truncate"><%= c.description || 'Get discount on your order' %></p>
                            <p class="text-xs text-zinc-400 mt-1">
                                Min Purchase: ₹<%= c.minimumPurchase %> | 
                                Discount: <%= c.discountType === 'PERCENTAGE' ? `${c.discountValue}%` : `₹${c.discountValue}` %>
                            </p>
                        </div>
                        <button 
                            type="button" 
                            onclick="selectCoupon('<%= c.code %>')"
                            class="bg-lime-400 hover:bg-lime-300 text-black text-xs font-bold px-3 py-2 rounded-lg transition shrink-0"
                        >
                            Apply
                        </button>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-zinc-500 text-sm text-center py-4">No coupons available at the moment.</p>
            <% } %>
        </div>
    </div>
</div>
