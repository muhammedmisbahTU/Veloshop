<div class="max-w-7xl mx-auto px-5 py-10">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">

        <div>
            <h1 class="text-3xl font-bold text-white">
                Order Details
            </h1>

            <p class="text-zinc-400 mt-2">
                Order #
                <span class="text-lime-400 font-semibold">
                    <%= order.orderNumber %>
                </span>
            </p>
        </div>

        <a
        href="/orders/<%= order._id %>/invoice"
        class="inline-flex items-center gap-2 
        bg-lime-400 hover:bg-lime-300 
        text-black px-5 py-3 rounded-xl 
        font-semibold">


        Download Invoice PDF

        </a>

        <a href="/orders"
           class="border border-white/10 hover:border-lime-400 hover:text-lime-400 transition px-5 py-3 rounded-xl text-sm">
            ← Back to Orders
        </a>

    </div>


    <div class="grid lg:grid-cols-3 gap-8">

        <!-- LEFT -->

        <div class="lg:col-span-2 space-y-6">

            <!-- Order Items -->

            <div class="bg-zinc-900 rounded-2xl p-6">

                <h2 class="text-xl font-semibold text-white mb-6">
                    Ordered Items
                </h2>

                <% order.items.forEach(item=>{ %>

                <div class="flex gap-4 py-5 border-b border-zinc-800 last:border-0">

                    <img
                        src="<%= item.thumbnail %>"
                        class="w-24 h-24 rounded-xl object-cover">

                    <div class="flex-1">

                        <h3 class="text-lg font-semibold text-white">
                            <%= item.productName %>
                        </h3>

                        <p class="text-zinc-400 text-sm mt-2">
                            SKU :
                            <%= item.sku %>
                        </p>

                        <p class="text-zinc-400 text-sm">
                            Quantity :
                            <%= item.quantity %>
                        </p>

                        <p class="text-zinc-400 text-sm">
                            Price :
                            ₹<%= item.price %>
                        </p>

                        <div class="mt-3">


                        <% if (item.itemStatus === "CANCELLED") { %>

                            <span class="text-red-400 text-sm">
                                <%= item.itemStatus %>
                            </span>

                            <p class="text-sm text-red-400 mt-2">
                                Reason: <%= item.cancelReason %>
                            </p>

                        <% } else if (
                            item.itemStatus === "ACTIVE" &&
                            order.status !== "SHIPPED" &&
                            order.status !== "DELIVERED"
                        ) { %>

                            <button
                                onclick="cancelItem('<%= order._id %>','<%= item._id %>')"
                                class="text-sm text-red-400 hover:text-red-300">
                                Cancel Product
                            </button>

                        <% } else if (
                            item.itemStatus === "ACTIVE" &&
                            order.status === "DELIVERED" &&
                            item.returnStatus === "NONE"
                        ) { %>

                            <button
                                onclick="returnItem('<%= order._id %>','<%= item._id %>')"
                                class="text-sm text-yellow-400 hover:text-yellow-300">
                                Return Product
                            </button>

                        <% } else if (item.returnStatus === "REQUESTED") { %>

                            <span class="text-yellow-400 text-sm">
                                Return Requested
                            </span>

                            <p class="text-zinc-400 text-sm">
                                Reason: <%= item.returnReason %>
                            </p>

                        <% } else { %>

                            <span class="text-sm text-green-400">
                                <%= item.itemStatus %>
                            </span>

                        <% } %>

                        </div>

                        </div>

                    

                    <div class="font-bold text-lime-400 text-lg">

                        ₹<%= (item.price * item.quantity).toFixed(2) %>

                    </div>

                </div>

                <% }) %>

            </div>


            <!-- Shipping -->

            <div class="bg-zinc-900 rounded-2xl p-6">

                <h2 class="text-xl font-semibold text-white mb-5">
                    Delivery Address
                </h2>

                <div class="space-y-2 text-zinc-300">

                    <p class="font-semibold text-white">
                        <%= order.addressSnapshot.fullName %>
                    </p>

                    <p>
                        <%= order.addressSnapshot.addressLine1 %>
                    </p>

                    <% if(order.addressSnapshot.addressLine2){ %>

                    <p>
                        <%= order.addressSnapshot.addressLine2 %>
                    </p>

                    <% } %>

                    <p>
                        <%= order.addressSnapshot.city %>,
                        <%= order.addressSnapshot.state %>
                    </p>

                    <p>
                        <%= order.addressSnapshot.pinCode %>
                    </p>

                    <p>
                        <%= order.addressSnapshot.country %>
                    </p>

                </div>

            </div>

        </div>


        <!-- RIGHT -->

        <div>

            <div class="bg-zinc-900 rounded-2xl p-6 sticky top-24">

                <h2 class="text-xl font-bold text-white mb-6">
                    Order Summary
                </h2>


                <div class="space-y-4">

                    <div class="flex justify-between">
                        <span class="text-zinc-400">
                            Order Status
                        </span>

                        <span class="bg-lime-400/20 text-lime-400 px-3 py-1 rounded-full text-sm">
                            <%= order.status %>
                        </span>
                    </div>


                    <div class="flex justify-between">
                        <span class="text-zinc-400">
                            Payment
                        </span>

                        <span class="text-white">
                            <%= order.paymentMethod %>
                        </span>
                    </div>


                    <div class="flex justify-between">
                        <span class="text-zinc-400">
                            Payment Status
                        </span>

                        <span class="<%= order.paymentStatus === 'SUCCESS'
                            ? 'text-lime-400'
                            : order.paymentStatus === 'FAILED'
                            ? 'text-red-400'
                            : 'text-yellow-400' %>">

                            <%= order.paymentStatus %>

                        </span>
                    </div>


                    <div class="flex justify-between">
                        <span class="text-zinc-400">
                            Ordered On
                        </span>

                        <span>
                            <%= new Date(order.createdAt).toLocaleDateString() %>
                        </span>
                    </div>

                </div>


                <hr class="border-zinc-700 my-6">


                <div class="space-y-3">

                    <div class="flex justify-between">
                        <span class="text-zinc-400">
                            Subtotal
                        </span>

                        <span>
                            ₹<%= order.subtotal.toFixed(2) %>
                        </span>
                    </div>


                    <div class="flex justify-between">

                        <span class="text-zinc-400">
                            Coupon Discount
                        </span>

                        <span class="text-red-400">
                            -₹<%= order.couponDiscount.toFixed(2) %>
                        </span>

                    </div>


                    <div class="flex justify-between">

                        <span class="text-zinc-400">
                            Offer Discount
                        </span>

                        <span class="text-red-400">
                            -₹<%= order.offerDiscount.toFixed(2) %>
                        </span>

                    </div>


                    <div class="flex justify-between">

                        <span class="text-zinc-400">
                            Tax
                        </span>

                        <span>
                            ₹<%= order.taxAmount.toFixed(2) %>
                        </span>

                    </div>


                    <div class="flex justify-between">

                        <span class="text-zinc-400">
                            Shipping
                        </span>

                        <% if(order.shippingCost===0){ %>

                        <span class="text-lime-400">
                            Free
                        </span>

                        <% }else{ %>

                        <span>
                            ₹<%= order.shippingCost.toFixed(2) %>
                        </span>

                        <% } %>

                    </div>


                    <div class="border-t border-zinc-700 pt-4 flex justify-between text-xl font-bold">

                        <span>
                            Grand Total
                        </span>

                        <span class="text-lime-400">
                            ₹<%= order.grandTotal.toFixed(2) %>
                        </span>

                    </div>

                </div>


                <div class="mt-8 space-y-3">

                    <% if(order.status==="PENDING" || order.status==="CONFIRMED"){ %>


                    <button
                    onclick="cancelOrder('<%= order._id %>')"
                    class="w-full bg-red-500 hover:bg-red-600 text-white py-3 rounded-xl font-semibold">

                    Cancel Order

                    </button>


                    <% } %>

                    <a href="/shop"
                       class="block w-full text-center border border-white/10 hover:border-lime-400 hover:text-lime-400 transition py-3 rounded-xl">

                        Continue Shopping

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
<div id="cancelModal"
class="fixed inset-0 hidden items-center justify-center bg-black/70 z-50">


<div class="bg-zinc-900 rounded-2xl p-6 w-full max-w-md">

<h2 class="text-xl font-bold text-white mb-4">
Cancel Product
</h2>


<textarea
id="cancelReason"
placeholder="Reason for cancellation (optional)"
class="w-full bg-zinc-800 border border-white/10 rounded-xl p-3 text-white h-32 resize-none">
</textarea>


<div class="flex justify-end gap-3 mt-5">


<button
onclick="closeCancelModal()"
class="px-5 py-2 border border-white/20 text-gray-300 rounded-xl">

Close

</button>


<button
onclick="confirmCancelItem()"
class="px-5 py-2 bg-red-500 text-white rounded-xl">

Cancel Product

</button>


</div>


</div>

</div>

<div id="returnModal"
class="fixed inset-0 hidden items-center justify-center bg-black/70 z-50">


<div class="bg-zinc-900 rounded-2xl p-6 w-full max-w-md">


<h2 class="text-xl font-bold text-white mb-4">
Return Product
</h2>


<textarea

id="returnReason"

placeholder="Enter return reason"

class="w-full bg-zinc-800 text-white rounded-xl p-3 h-32"

></textarea>



<div class="flex justify-end gap-3 mt-5">


<button
onclick="closeReturnModal()"
class="border border-white/20 px-5 py-2 rounded-xl text-gray-300">

Cancel

</button>


<button

onclick="submitReturn()"

class="bg-yellow-400 text-black px-5 py-2 rounded-xl font-semibold">

Submit Return

</button>


</div>


</div>


</div>
<script>

async function cancelOrder(id){


const confirmCancel = await Swal.fire({

title:"Cancel Order?",

text:"Stock will be added back to inventory",

icon:"warning",

showCancelButton:true,

confirmButtonText:"Yes, Cancel"

});


if(!confirmCancel.isConfirmed)
return;



const response = await fetch(
`/orders/${id}/cancel`,
{
method:"POST",
headers:{
  "Content-Type":"application/json"
},
body:JSON.stringify({ reason: "" })
}
);


const data = await response.json();



if(data.success){

Swal.fire({

icon:"success",
title:data.message

}).then(()=>{

location.reload();

});


}else{


Swal.fire({

icon:"error",
title:data.message

});


}


}

let selectedOrderId=null;
let selectedItemId=null;


function cancelItem(orderId,itemId){

selectedOrderId=orderId;
selectedItemId=itemId;


document
.getElementById("cancelModal")
.classList.remove("hidden");


document
.getElementById("cancelModal")
.classList.add("flex");

}



function closeCancelModal(){

document
.getElementById("cancelModal")
.classList.add("hidden");


document
.getElementById("cancelModal")
.classList.remove("flex");


document.getElementById("cancelReason").value="";

}



async function confirmCancelItem(){


const reason =
document.getElementById("cancelReason").value.trim();



const response = await fetch(
`/orders/${selectedOrderId}/item/${selectedItemId}/cancel`,
{

method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({
reason
})

}
);



const data = await response.json();



if(data.success){


Swal.fire({

icon:"success",
title:data.message

})
.then(()=>{

location.reload();

});


}else{


Swal.fire({

icon:"error",
title:data.message

});


}



}


let returnOrderId=null;
let returnItemId=null;



function returnItem(orderId,itemId){


returnOrderId=orderId;
returnItemId=itemId;


document
.getElementById("returnModal")
.classList.remove("hidden");


document
.getElementById("returnModal")
.classList.add("flex");


}



function closeReturnModal(){


document
.getElementById("returnModal")
.classList.add("hidden");


document
.getElementById("returnModal")
.classList.remove("flex");


document.getElementById("returnReason").value="";


}



async function submitReturn(){


const reason =
document.getElementById("returnReason").value.trim();



if(!reason){

return Swal.fire({

icon:"warning",

title:"Reason required"

});

}



const response = await fetch(

`/orders/${returnOrderId}/item/${returnItemId}/return`,

{

method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({

reason

})

}

);



const data =
await response.json();



if(data.success){


Swal.fire({

icon:"success",

title:data.message

}).then(()=>{

location.reload();

});


}

else{


Swal.fire({

icon:"error",

title:data.message

});


}


}

</script>