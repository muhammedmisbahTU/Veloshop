<div class="max-w-7xl mx-auto px-4 py-12">
    <!-- Breadcrumbs -->

    <nav class="flex items-center gap-2 text-sm text-zinc-400 mb-8">

        <a href="/" class="hover:text-lime-400">
            Home
        </a>

        <span>
            /
        </span>

        <a href="/shop" class="hover:text-lime-400">
            Shop
        </a>

        <span>
            /
        </span>

        <% if(product.category){ %>

            <a 
                href="/category/<%= product.category.slug %>"
                class="hover:text-lime-400">

                <%= product.category.name %>

            </a>

            <span>
                /
            </span>

        <% } %>


        <span class="text-white font-semibold">

            <%= product.name %>

        </span>

    </nav>

    <div class="grid lg:grid-cols-2 gap-12">

        <!-- LEFT -->

        <div>

            <!-- Main Image -->

            <div id="zoomContainer"
                class="relative bg-zinc-950 rounded-3xl overflow-hidden border border-white/10">

                <img
                    id="mainImage"
                    src="<%= defaultVariant.images[0] %>"
                    data-zoom="<%= defaultVariant.images[0] %>"
                    class="w-full aspect-square object-contain cursor-zoom-in">
                <div id="zoomPane"
                    class="absolute z-50 hidden lg:block">
                </div>
            </div>

            <!-- Gallery -->

            <div id="gallery" class="grid grid-cols-5 gap-3 mt-4">
                <% defaultVariant.images.forEach(img => { %>
                    <button
                        onclick="changeImage('<%= img %>')"
                        class="border border-white/10 rounded-xl overflow-hidden">

                        <img src="<%= img %>"
                            class="w-full aspect-square object-contain">

                    </button>
                <% }) %>
            </div>

        </div>

        <!-- RIGHT -->

        <div class="space-y-6">

            <div>

                <p class="text-lime-400 uppercase text-sm font-bold">

                    <%= product.brand %>

                </p>

                <h1 class="text-4xl font-black mt-2">

                    <%= product.name %>

                </h1>

                <p class="text-zinc-400 mt-4">

                    <%= product.description %>

                </p>

            </div>

            <!-- Highlights -->

            <div>

            <h3 class="text-xl font-bold">
            Product Highlights
            </h3>


            <ul class="list-disc ml-5 text-zinc-400">

            <li>Premium Quality</li>

            <li>Fast Delivery</li>

            <li>Easy Return</li>

            <li>Warranty Available</li>

            </ul>

            </div>

            <!-- Rating -->

            <div class="flex items-center gap-3">

                <span class="text-yellow-400">

                    ★★★★★

                </span>

                <span class="text-zinc-500">

                    <%= product.averageRating %>

                    (<%= product.totalReviews %> Reviews)

                </span>

            </div>

            <!-- Price -->

            <div>

                <% if(defaultVariant.salePrice){ %>

                    <div class="flex items-center gap-3">

                        <span id="salePrice"
                            class="text-4xl font-black text-white">

                            ₹<%= defaultVariant.salePrice %>

                        </span>

                        <span id="regularPrice"
                            class="line-through text-zinc-500">

                            ₹<%= defaultVariant.regularPrice %>

                        </span>

                    </div>

                <% }else{ %>

                    <span id="salePrice"
                        class="text-4xl font-black">

                        ₹<%= defaultVariant.regularPrice %>

                    </span>

                <% } %>

            </div>

            <!-- Discount -->
            <span id="discount">
            <% if (defaultDiscount) { %>
                <%= defaultDiscount %>% OFF
            <% } %>
            </span>
            <!-- Stock -->

            <div>

            <% if(defaultVariant.stock > 0 && defaultVariant.stock < 10){ %>

                <span id="stockStatus"
                    class="text-yellow-400 font-bold">
                    Only <%= defaultVariant.stock %> left
                </span>

            <% } else if(defaultVariant.stock >= 10){ %>

                <span id="stockStatus"
                    class="text-lime-400 font-bold">
                    In Stock
                </span>

            <% } else { %>

                <span id="stockStatus"
                    class="text-red-500 font-bold">
                    Out of Stock
                </span>

            <% } %>

            </div>

            <!-- Attributes -->

            <div class="space-y-5">

                <% const grouped={}; %>

                <% variants.forEach(v=>{ %>

                    <% v.attributes.forEach(a=>{ %>

                        <% if(!grouped[a.name]) grouped[a.name]=[]; %>

                        <% if(!grouped[a.name].includes(a.value)) grouped[a.name].push(a.value); %>

                    <% }) %>

                <% }) %>

                <% Object.keys(grouped).forEach(key=>{ %>

                    <div>

                        <p class="font-semibold mb-3">

                            <%= key %>

                        </p>

                        <div class="flex gap-3 flex-wrap">

                            <% grouped[key].forEach(value=>{ %>

                                <button
                                    class="attribute-btn px-4 py-2 rounded-xl border border-white/10 hover:border-lime-400"
                                    data-name="<%= key %>"
                                    data-value="<%= value %>">

                                    <%= value %>

                                </button>

                            <% }) %>

                        </div>

                    </div>

                <% }) %>

            </div>

            <!-- Quantity -->

            <div class="flex items-center gap-4">

                <input
                    id="quantity"
                    type="number"
                    value="1"
                    min="1"
                    class="w-20 bg-zinc-950 border border-white/10 rounded-xl text-center py-3">
                <input
                    type="hidden"
                    id="productId"
                    value="<%= product._id %>">
                <input 
                    type="hidden"
                    id="variantId">
                <button id="addCartBtn" 
                    class="flex-1 py-4 rounded-xl bg-lime-400 text-black font-bold hover:bg-lime-300">

                    Add to Cart

                </button>

            </div>

        </div>
</div>
<% if (relatedProducts.length > 0) { %>

<section class="mt-20">

    <div class="flex items-center justify-between mb-8">

        <h2 class="text-3xl font-bold text-white">
            Related Products
        </h2>

        <a
            href="/shop?category=<%= product.categoryId.slug %>"
            class="text-lime-400 hover:text-lime-300 font-medium">

            View All →

        </a>

    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">

        <% relatedProducts.forEach(p => { %>

        <a
            href="/products/<%= p._id %>"
            class="group rounded-2xl overflow-hidden bg-zinc-900 border border-white/10 hover:border-lime-400 transition duration-300">

            <div class="aspect-square overflow-hidden bg-zinc-950">

                <img
                    src="<%= p.variant?.images?.[0] || '/images/no-image.png' %>"
                    alt="<%= p.name %>"
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-300">

            </div>

            <div class="p-4">

                <p class="text-sm text-zinc-400 mb-1">
                    <%= p.brand %>
                </p>

                <h3 class="font-semibold text-white line-clamp-2 h-12">
                    <%= p.name %>
                </h3>

                <div class="mt-3 flex items-center gap-2">

                    <% if(p.variant.salePrice){ %>

                        <span class="text-lime-400 font-bold text-lg">
                            ₹<%= p.variant.salePrice %>
                        </span>

                        <span class="text-sm text-zinc-500 line-through">
                            ₹<%= p.variant.regularPrice %>
                        </span>

                    <% } else { %>

                        <span class="text-lime-400 font-bold text-lg">
                            ₹<%= p.variant.regularPrice %>
                        </span>

                    <% } %>

                </div>

            </div>

        </a>

        <% }) %>

    </div>

</section>

<% } %>

<script>

const selected = {};

document.querySelectorAll(".attribute-btn").forEach(btn=>{

    btn.addEventListener("click",()=>{

        selected[btn.dataset.name]=btn.dataset.value;

        document.querySelectorAll(
            `[data-name="${btn.dataset.name}"]`
        ).forEach(b=>{

            b.classList.remove(
                "bg-lime-400",
                "text-black"
            );

        });

        btn.classList.add(
            "bg-lime-400",
            "text-black"
        );

        findVariant();

    });

});

function findVariant() {

    const variant = variants.find(v => {
        return Object.entries(selected).every(([k, vl]) => {
            return v.attributes.some(a => a.name === k && a.value === vl);
        });
    });

    if (!variant) return;

    //store selected variant id 
    document.getElementById("variantId").value = variant.id;
    //Discount
    const discount = document.getElementById("discount");

    if (variant.salePrice) {

        let percent = Math.round(
            ((variant.regularPrice - variant.salePrice) /
            variant.regularPrice) * 100
        );

        discount.innerHTML = percent + "% OFF";

    } else {
        discount.innerHTML = "";
    }

    const stock=document.getElementById("stockStatus");


    // Product Stock Status Indicator
    if(variant.stock > 10){

        stock.innerHTML="In Stock";
        stock.className="text-lime-400 font-bold";

    }
    else if(variant.stock > 0){

        stock.innerHTML=
        `Only ${variant.stock} left`;

        stock.className="text-yellow-400 font-bold";

    }
    else{

        stock.innerHTML="Out of Stock";

        stock.className="text-red-500 font-bold";

    }

    //Disable Add To Cart When Out Of Stock
    const cartBtn=document.getElementById("addCartBtn");

    if(variant.stock<=0){

        cartBtn.disabled=true;

        cartBtn.innerHTML="Out of Stock";
        cartBtn.className = "flex-1 py-4 rounded-xl bg-red-500 text-white font-bold hover:bg-red-400 cursor-not-allowed";
    }
    else{

        cartBtn.disabled=false;

        cartBtn.innerHTML="Add to Cart";
        cartBtn.className = "flex-1 py-4 rounded-xl bg-lime-400 text-black font-bold hover:bg-lime-300";

    }

    document.getElementById("salePrice").innerHTML =
        "₹" + (variant.salePrice || variant.regularPrice);

    if (document.getElementById("regularPrice")) {
        document.getElementById("regularPrice").innerHTML =
            "₹" + variant.regularPrice;
    }

    // Change main image
    const main=document.getElementById("mainImage");

    main.src = variant.images[0];
    main.dataset.zoom = variant.images[0];

    setTimeout(()=>{
        initZoom();
    },100);

    // Rebuild gallery
    const gallery = document.getElementById("gallery");

    gallery.innerHTML = variant.images.map(img => `
        <button
            onclick="changeImage('${img}')"
            class="border border-white/10 rounded-xl overflow-hidden">

            <img
                src="${img}"
                class="w-full h-20 object-cover">

        </button>
    `).join("");
}

function changeImage(src){

    const img=document.getElementById("mainImage");

    img.src=src;
    img.dataset.zoom=src;

    setTimeout(()=>{
        initZoom();
    },100);

}

window.addEventListener("DOMContentLoaded", () => {
    findVariant();
});

// Add to cart 
const addCartBtn = document.getElementById("addCartBtn");

addCartBtn.addEventListener("click", addToCart);
async function addToCart() {

    const productId = document.getElementById("productId").value;

    const variantId = document.getElementById("variantId").value;

    const quantity = Number(
        document.getElementById("quantity").value
    );

    try {

        const response = await fetch("/cart", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
        },
        body: JSON.stringify({
            productId,
            variantId,
            quantity
        })
        });

        const data = await response.json();

        if (data.redirect) {

            Swal.fire({
                icon: "warning",
                title: "Login Required",
                text: data.message,
                confirmButtonColor: "#84cc16"
            }).then(() => {

                window.location.href = data.redirect;

            });

            return;
        }

        if (!data.success) {

            Swal.fire({
                icon: "error",
                title: "Oops!",
                text: data.message,
                confirmButtonColor: "#84cc16"
            });

            return;
        }


        Swal.fire({
            icon: "success",
            title: "Added to Cart",
            text: data.message,
            confirmButtonColor: "#84cc16",
            timer: 1500,
            showConfirmButton: false
        });

    } catch (err) {

        console.log(err);

    }

}

</script>
<script>

const variants = <%- JSON.stringify(
    variants.map(v=>({
        id:v._id,
        sku:v.sku,
        stock:v.stock,
        regularPrice:v.regularPrice,
        salePrice:v.salePrice,
        images:v.images,
        attributes:v.attributes
    }))
) %>;

</script>
<script src="/js/Drift.min.js"></script>
<script>
let drift;

function initZoom(){

    if(drift){
        drift.destroy();
    }

    const image = document.getElementById("mainImage");

    drift = new Drift(image, {
        sourceAttribute: "data-zoom",
        zoomFactor: 1.3,
        paneContainer: document.body,
        inlinePane: false,
        handleTouch: false
    });

}

initZoom();

</script>
